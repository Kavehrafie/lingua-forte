# =============================================================================
# Local development only.
# Wrangler v4 loads this file automatically during `wrangler dev` / `bun run dev`.
# It is NOT deployed — see "Production" below for what actually ships.
# =============================================================================

# --- Production secrets (also set locally so dev matches prod) ---------------
# These two MUST be set on Cloudflare separately. Run:
#   bun run secrets:setup
# That script runs `wrangler secret put` for each one. Values set that way
# persist across every deploy — they do not get erased.
BETTER_AUTH_SECRET=""
RESEND_API_KEY=""

# --- Runtime config (non-secret) ---------------------------------------------
# In production these come from wrangler.jsonc `vars` (ADMIN_EMAIL, NOREPLY_EMAIL)
# or as a secret (BETTER_AUTH_URL, until you promote it to a var).
BETTER_AUTH_URL=http://localhost:4321

# --- Local-only — NEVER needed on the Worker ---------------------------------
# These are read by drizzle-kit to apply migrations to remote D1 over HTTP.
# Do not run `wrangler secret put` for these — they don't belong in production.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""
