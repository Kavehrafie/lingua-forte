---
import Layout from "@/layouts/Layout.astro";
import {
  Sidebar,
  SidebarContent,
  SidebarFooter,
  SidebarGroup,
  SidebarGroupContent,
  SidebarGroupLabel,
  SidebarInset,
  SidebarMenu,
  SidebarMenuButton,
  SidebarMenuItem,
  SidebarProvider,
  SidebarTrigger,
} from "@/components/ui/sidebar";
import { Icon } from "@/components/ui/icon";
import type { User } from "better-auth";

interface Props {
  user: User;
}

const { user }: Props = Astro.props;

const pathname = Astro.url.pathname;
// /admin and /admin/page/{id}... count as "Pages" too — they're all page-editing.
const isPagesActive =
  pathname === "/admin/pages" ||
  pathname === "/admin" ||
  pathname.startsWith("/admin/page/");
const isSlotsActive = pathname.startsWith("/admin/interview-slots");
const isSignupsActive = pathname.startsWith("/admin/signups");
---

<Layout showPublicHeader={false} showPublicFooter={false}>
  <SidebarProvider>
    <Sidebar collapsible="icon">
      <SidebarContent>
        <SidebarGroup>
          <SidebarGroupLabel>Content</SidebarGroupLabel>
          <SidebarGroupContent>
            <SidebarMenu>
              <SidebarMenuItem>
                <SidebarMenuButton href="/admin/pages" isActive={isPagesActive}>
                  <Icon name="file-text" />
                  <span>Pages</span>
                </SidebarMenuButton>
              </SidebarMenuItem>
              <SidebarMenuItem>
                <SidebarMenuButton href="/admin/page/create">
                  <Icon name="plus" />
                  <span>New page</span>
                </SidebarMenuButton>
              </SidebarMenuItem>
            </SidebarMenu>
          </SidebarGroupContent>
        </SidebarGroup>
        <SidebarGroup>
          <SidebarGroupLabel>Signups</SidebarGroupLabel>
          <SidebarGroupContent>
            <SidebarMenu>
              <SidebarMenuItem>
                <SidebarMenuButton
                  href="/admin/interview-slots"
                  isActive={isSlotsActive}
                >
                  <Icon name="calendar" />
                  <span>Interview slots</span>
                </SidebarMenuButton>
              </SidebarMenuItem>
              <SidebarMenuItem>
                <SidebarMenuButton
                  href="/admin/signups"
                  isActive={isSignupsActive}
                >
                  <Icon name="users" />
                  <span>Signups</span>
                </SidebarMenuButton>
              </SidebarMenuItem>
              <SidebarMenuItem>
                <SidebarMenuButton href="/">
                  <Icon name="external-link" />
                  <span>View site</span>
                </SidebarMenuButton>
              </SidebarMenuItem>
            </SidebarMenu>
          </SidebarGroupContent>
        </SidebarGroup>
      </SidebarContent>
      <SidebarFooter>
        <SidebarMenu>
          <SidebarMenuItem>
            <button
              id="sign-out-btn"
              type="button"
              class="flex w-full cursor-pointer items-center gap-2 overflow-hidden rounded-md p-2 text-left text-sm outline-hidden transition-colors hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 group-data-[collapsible=icon]:size-8! group-data-[collapsible=icon]:p-2! [&_svg]:size-4 [&_svg]:shrink-0 [&>span:last-child]:truncate"
              title="Sign out"
            >
              <Icon name="log-out" />
              <span>Sign out</span>
            </button>
          </SidebarMenuItem>
        </SidebarMenu>
      </SidebarFooter>
    </Sidebar>
    <SidebarInset>
      <header class="flex h-14 items-center gap-2 border-b px-6">
        <SidebarTrigger />
        <span class="text-sm font-medium">Workspace</span>
      </header>
      <main class="flex-1 p-4">
        <slot />
      </main>
    </SidebarInset>
  </SidebarProvider>
</Layout>

<script>
  // Inline script — no bundler, no imports, runs the moment the parser hits it.
  // If the click ever stops working, this is the place to look first.

  import { authClient } from "@/lib/auth-client";

  console.log("[admin] signout script loaded");

  document.addEventListener("click", async function (event) {
    var target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (!target.closest("#sign-out-btn")) return;

    event.preventDefault();
    console.log("[sign-out] clicked");
    try {
      await authClient.signOut();
