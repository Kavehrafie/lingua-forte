---
import "../styles/global.css";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/inter-tight";
import Header2Block from "@/components/blocks/header-2.astro";
import { ThemeProvider } from "@/components/ui/theme-toggle";
import Footer3Block from "@/components/blocks/footer-3.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <ThemeProvider />
    <title>Lingua Forte: English classes and tutoring</title>
  </head>
  <body>
    <Header2Block
      logo={{
        label: "Lingua Forte",
        href: "/",
      }}
      navigation={[
        { label: "About", href: "#about" },
        { label: "Programs", href: "#programs" },
        { label: "How it works", href: "#how-it-works" },
      ]}
      buttons={[{ label: "Get started", href: "/signup", variant: "default" }]}
    />
    <slot />
    <Footer3Block
      brandName="Lingua Forte"
      brandHref="/"
      description="Personalized English classes built on dialogue, for any exam and everyday communication."
      columns={[
        {
          title: "Explore",
          links: [
            { label: "About", href: "#about" },
            { label: "Programs", href: "#programs" },
            { label: "How it works", href: "#how-it-works" },
            { label: "FAQs", href: "#faqs" },
          ],
        },
        {
          title: "Contact",
          links: [
            { label: "linguforte@protonmail.com", href: "mailto:linguforte@protonmail.com" },
            { label: "Griffintown, Montreal, QC", href: "https://maps.google.com/?q=Griffintown+Montreal+QC" },
            { label: "Weekdays, 8am-4pm EDT", href: "#" },
          ],
        },
      ]}
      copyright="© 2026 Lingua Forte"
      bottomLinks={[
        { label: "Privacy", href: "/" },
        { label: "Terms", href: "/" },
        { label: "Sitemap", href: "/" },
      ]}
    />
  </body>
</html>
