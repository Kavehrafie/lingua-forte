---
import { Button } from "@/components/ui/button";
import { Icon } from "@/components/ui/icon";
import { cn } from "@/lib/utils";
import { formatDateInTz } from "@/lib/time";

type Signup = {
  id: string;
  fullName: string;
  email: string;
  courseTitle: string;
  bookedFor: Date;
  note: string | null;
  status: "confirmed" | "cancelled";
  createdAt: Date;
};

interface Props {
  signups: Signup[];
}

const { signups } = Astro.props;

const fmt = (d: Date) =>
  formatDateInTz(d, {
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZoneName: "short",
  });
---

{
  signups.length === 0 ? (
    <div class="rounded-lg border border-dashed px-4 py-12 text-center">
      <p class="text-sm text-muted-foreground">No signups yet.</p>
    </div>
  ) : (
    <div class="overflow-x-auto rounded-lg border">
      <table class="w-full text-sm">
        <thead class="bg-muted/40 text-left text-xs uppercase tracking-wide text-muted-foreground">
          <tr>
            <th class="px-4 py-3 font-medium">Name</th>
            <th class="px-4 py-3 font-medium">Email</th>
            <th class="px-4 py-3 font-medium">Course</th>
            <th class="px-4 py-3 font-medium">Interview</th>
            <th class="px-4 py-3 font-medium">Note</th>
            <th class="px-4 py-3 font-medium">Status</th>
            <th class="px-4 py-3" />
          </tr>
        </thead>
        <tbody class="divide-y">
          {signups.map((signup) => (
            <tr class={cn(signup.status === "cancelled" && "opacity-60")}>
              <td class="px-4 py-3 font-medium">{signup.fullName}</td>
              <td class="px-4 py-3">{signup.email}</td>
              <td class="px-4 py-3">{signup.courseTitle}</td>
              <td class="px-4 py-3">{fmt(signup.bookedFor)}</td>
              <td class="max-w-xs truncate px-4 py-3 text-muted-foreground">
                {signup.note ?? "—"}
              </td>
              <td class="px-4 py-3">
                <span
                  class={cn(
                    "rounded-full border px-2 py-0.5 text-xs font-medium",
                    signup.status === "confirmed"
                      ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-600"
                      : "border-muted-foreground/30 bg-muted/40 text-muted-foreground",
                  )}
                >
                  {signup.status}
                </span>
              </td>
              <td class="px-4 py-3 text-right">
                {signup.status === "confirmed" && (
                  <Button
                    variant="destructive"
                    size="sm"
                    data-signup-id={signup.id}
                  >
                    <Icon name="x" />
                    Cancel
                  </Button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
