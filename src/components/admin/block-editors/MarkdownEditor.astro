---
import type { HTMLAttributes } from "astro/types";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@/components/ui/field";
import { Form } from "@/components/ui/form";
import { Textarea } from "@/components/ui/textarea";
import { Button } from "@/components/ui/button";
import { Icon } from "@/components/ui/icon";
import { actions } from "astro:actions";

type Block = NonNullable<
  Awaited<ReturnType<typeof import("@/lib/server/page").getBlockById>>
>;

type Props = HTMLAttributes<"div"> & {
  block: Block;
  pageId: string;
  error?: string | null;
};

const { block, pageId, error = null, ...rest } = Astro.props;

const content =
  block.content && typeof block.content === "object" && "markdown" in block.content
    ? String((block.content as { markdown: unknown }).markdown ?? "")
    : "";
---

<div {...rest}>
  <a
    href={`/admin/page/${pageId}/blocks`}
    class="mb-4 inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"
  >
    <Icon name="arrow-left" />
    Back to blocks
  </a>

  <Form method="post" action={actions.updateBlock}>
    <input type="hidden" name="id" value={block.id} />

    <Card>
      <CardHeader>
        <CardTitle>Edit markdown block</CardTitle>
        <CardDescription>
          Renders as formatted text on the published page.
        </CardDescription>
      </CardHeader>

      <CardContent>
        <FieldGroup>
          <Field>
            <FieldLabel for="content">Markdown</FieldLabel>
            <Textarea
              id="content"
              name="content"
              rows={12}
              class="font-mono text-sm"
              placeholder="# Heading

Body text in **markdown**."
            >{content}</Textarea>
            <FieldDescription>
              Supports headings, lists, links, emphasis.
            </FieldDescription>
            {error && <FieldError>{error}</FieldError>}
          </Field>

          <Field>
            <label class="flex items-center gap-2 text-sm font-medium">
              <input
                type="checkbox"
                name="isVisible"
                value="true"
                checked={block.isVisible}
                class="size-4 rounded border-input"
              />
              Visible on published page
            </label>
          </Field>
        </FieldGroup>
      </CardContent>

      <CardContent class="flex items-center justify-between gap-2">
        <Button type="submit">Save block</Button>
      </CardContent>
    </Card>
  </Form>

  <Form method="post" action={actions.deleteBlock} class="mt-4">
    <input type="hidden" name="id" value={block.id} />
    <Button
      type="submit"
      variant="outline"
      class="gap-2 text-destructive hover:text-destructive"
    >
      <Icon name="trash" />
      Delete block
    </Button>
  </Form>
</div>
