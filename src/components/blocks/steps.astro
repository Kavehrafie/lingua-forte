---
import { Section, SectionContainer } from "@/components/ui/section";
type Step = {
  title: string;
  description: string;
};

const steps: Step[] = [
  {
    title: "Register online",
    description: "Sign up for a free account to get started.",
  },
  {
    title: "Choose your plan",
    description: "Select the plan that best fits your needs.",
  },
  {
    title: "Start using the product",
    description: "Access all features and enjoy the benefits.",
  },
];
---

<Section>
  <SectionContainer class="py-24 gap-24">
    <h2
      class="text-foreground text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
    >
      Four Steps to Fluency
    </h2>
    <div class="flex flex-row justify-between gap-0">
      {
        steps.map((step, index) => (
          <div class="flex flex-1 items-start gap-4">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-white">
              {index + 1}
            </div>
            <div class="flex-1">
              <div class="flex gap-2">
                <h3 class="text-lg font-semibold min-w-45">{step.title}</h3>
                {index < steps.length - 1 && (
                  <span class="bg-primary h-1 w-full mt-[14px] -mr-1" />
                )}
              </div>
              <p class="text-muted-foreground">{step.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </SectionContainer>
</Section>
