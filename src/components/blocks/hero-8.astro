---
import { Image } from "astro:assets";
import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";
import { Icon } from "@/components/ui/icon";
import { Section, SectionContainer } from "@/components/ui/section";
import Calder from "@/assets/calder.svg";
type Props = {
  class?: string;
  title: string;
  description: string;
  buttons: {
    label: string;
    href: string;
    variant?: "default" | "outline" | "secondary" | "ghost";
  }[];
  image: {
    src: ImageMetadata;
    alt: string;
  };
};

const {
  class: className,
  title,
  description,
  buttons,
  image,
}: Props = Astro.props;

// Editorial type-led hero: text column on the left, feature image on the right.
// The headline carries the weight. Newsreader italic on the accent word
// does the emphasis; no decorative markup needed.
---

<Section class={cn("", className)}>
  <SectionContainer>
    <div
      class="grid items-start gap-12 lg:grid-cols-5 lg:gap-16"
      style="place-items: center;"
    >
      <!-- Image column -->
      <div class="lg:col-span-2">
        <Calder class="w-full" />
        <!-- <Image
          src={image.src}
          alt={image.alt}
          class="w-full border border-border/60 object-cover"
          widths={[640, 960, 1280, 1920]}
          loading="eager"
        /> -->
      </div>
      <!-- Text column -->
      <div class="lg:col-span-3">
        <p
          class="font-sans text-xs font-semibold tracking-[0.2em] text-accent uppercase"
        >
          Language classes in Montreal
        </p>
        <h1
          class="text-foreground font-display mt-6 text-4xl leading-[1.1] font-medium tracking-[-0.02em] text-balance sm:text-5xl lg:text-6xl"
          set:html={title}
        />
        <p
          class="mt-6 max-w-[58ch] text-base leading-relaxed text-foreground/80 sm:text-lg"
          set:html={description}
        />

        <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3">
          {
            buttons.map(({ href, label, ...button }, index) => (
              <Button
                as="a"
                href={href}
                size="lg"
                variant={
                  button.variant ?? (index === 0 ? "default" : "secondary")
                }
                class="h-12 px-6 text-base"
                {...button}
              >
                {label}
                {index === 0 && (
                  <Icon
                    name="arrow-right"
                    class="size-4 transition-transform duration-200 group-hover/button:translate-x-0.5"
                  />
                )}
              </Button>
            ))
          }
        </div>
      </div>
    </div>
  </SectionContainer>
</Section>
