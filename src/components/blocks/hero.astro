---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";
import { Icon } from "@/components/ui/icon";
import { Section, SectionContainer } from "@/components/ui/section";

type ImageProp = {
  src: ImageMetadata;
  alt: string;
};

type SvgProp = {
  component: import("astro/types").SvgComponent;
  alt: string;
};

type Props = {
  class?: string;
  title: string;
  description: string;
  subtitle?: string;
  buttons: {
    label: string;
    href: string;
    variant?: "default" | "outline" | "secondary" | "ghost";
  }[];
  image: ImageProp | SvgProp | undefined;
  variant?: "flex" | "1-3" | "3-1";
};

const {
  class: className,
  title,
  description,
  subtitle,
  buttons,
  image,
}: Props = Astro.props;

const isImage = image !== undefined && "src" in image;
const imageMeta: ImageProp | null = isImage ? image : null;
const svgComp = image !== undefined && "component" in image ? image.component : null;

// Editorial type-led hero: text column on the left, feature image on the right.
// The headline carries the weight. Newsreader italic on the accent word
// does the emphasis; no decorative markup needed.
---

<Section class={cn("parallax-hero", className)}>
  <SectionContainer>
    <div
      class="grid items-start gap-12 lg:grid-cols-5 lg:gap-16"
      style="place-items: center;"
    >
      <!-- Image column -->
      <div class="lg:col-span-2">
        {imageMeta && (
          <Image
            src={imageMeta.src}
            alt={imageMeta.alt}
            class="w-full border border-border/60 object-cover"
            widths={[640, 960, 1280, 1920]}
            loading="eager"
          />
        )}
        {svgComp && <svgComp class="w-full parallax-hero-layer" />}
      </div>
      <!-- Text column -->
      <div class="lg:col-span-3">
        {subtitle && (
          <p
            class="font-sans text-xs font-semibold tracking-[0.2em] text-accent uppercase"
          >
            {subtitle}
          </p>
        )}
        <h1
          class="text-foreground font-display mt-6 text-4xl leading-[1.1] font-medium tracking-[-0.02em] text-balance sm:text-5xl lg:text-6xl"
          set:html={title}
        />
        <p
          class="mt-6 max-w-[58ch] text-base leading-relaxed text-foreground/80 sm:text-lg"
          set:html={description}
        />

        <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3">
          {
            buttons.map(({ href, label, ...button }, index) => (
              <Button
                as="a"
                href={href}
                size="lg"
                variant={
                  button.variant ?? (index === 0 ? "default" : "secondary")
                }
                class="h-12 px-6 text-base"
                {...button}
              >
                {label}
                {index === 0 && (
                  <Icon
                    name="arrow-right"
                    class="size-4 transition-transform duration-200 group-hover/button:translate-x-0.5"
                  />
                )}
              </Button>
            ))
          }
        </div>
      </div>
    </div>
  </SectionContainer>
</Section>

<style>
  @property --parallax-y {
    syntax: "<percentage>";
    inherits: true;
    initial-value: 0%;
  }

  .parallax-hero {
    animation: hero-parallax linear both;
    animation-timeline: view();
    animation-range: exit;
  }

  @keyframes hero-parallax {
    from {
      --parallax-y: 0%;
    }
    to {
      --parallax-y: 40%;
    }
  }

  .parallax-hero-layer {
    transform: translateY(var(--parallax-y));
  }
</style>
