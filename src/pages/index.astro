---
import Layout from "../layouts/Layout.astro";
import Faqs4Block from "@/components/blocks/faqs-4.astro";
import placeholderImage from "@/assets/hero-sample-light.png";
import Steps from "@/components/blocks/steps.astro";
import Hero8Block from "@/components/blocks/hero-8.astro";
// import AboutBlock from "@/components/blocks/about.astro";
import Calder from "@/assets/calder-footer.svg";
import { Button } from "@/components/ui/button";
---

<Layout>
  <Hero8Block
    title="Speak with <em class='text-accent'>confidence</em>. Learn through real conversation."
    description="Personalized English classes tailored to your goals. Ready for any exam, every conversation."
    buttons={[{ label: "Get started", href: "/signup", variant: "default" }]}
    image={{
      src: placeholderImage,
      alt: "Two people in fluent English conversation",
    }}
  />

  <Steps />
  <Faqs4Block
    title="Frequently asked questions"
    faqs={[
      {
        id: "faq-hours",
        question: "How many hours do I need?",
        answer:
          "It depends on the result of your placement session, the daily time you commit to learning, and your motivation.",
      },
      {
        id: "faq-tailored",
        question: "Is it general or tailored and specific?",
        answer:
          "There is no clear-cut distinction. We tailor the course to get you ready for any exam as well as everyday and professional communication.",
      },
      {
        id: "faq-schedule",
        question: "What about the time and frequency of the classes?",
        answer:
          "That is between you and your instructor. You may have as many or as few hours per week as you want or need. We are flexible.",
      },
    ]}
  />
  <div
    class="grid grid-cols-2 gap-4 place-items-center place-content-center max-w-3xl mx-auto"
  >
    <div class="flex flex-col gap-4">
      <h2 class="text-2xl font-semibold tracking-tight">
        Adaptive Learning, Inspired by Calder's Mobiles
      </h2>
      <p class="text-muted-foreground">
        Inspired by Alexander Calder's adaptive mobiles, our courses move and
        adapt to each student's needs and goals. We believe language learning
        should be a fluid, interactive process that feels natural and intuitive.
        Students can explore new connections between words and ideas through
        real conversation.
      </p>
      <Button> About Us </Button>
    </div>
    <Calder class="h-full" />
  </div>
</Layout>
