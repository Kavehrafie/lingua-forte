---
import Layout from "../layouts/Layout.astro";
import Faqs4Block from "@/components/blocks/faqs-4.astro";
import Contact2Block from "@/components/blocks/contact-1.astro";
import placeholderImage from "@/assets/naassom-azevedo-Q_Sei-TqSlc-unsplash.jpg";
import Steps from "@/components/blocks/steps.astro";
import Hero8Block from "@/components/blocks/hero-8.astro";
---

<Layout>
  <Hero8Block
    title="Speak with <em class='text-accent'>confidence</em>. Learn through real conversation."
    description="Personalized English classes tailored to your goals. Ready for any exam, every conversation."
    buttons={[
      { label: "Get started", href: "/signup", variant: "default" },
    ]}
    image={{ src: placeholderImage, alt: "Two people in fluent English conversation" }}
  />

  <Contact2Block
    title="Let's work together"
    description="Tell us about the site, timeline, and what kind of help you need."
    contactItems={[
      {
        icon: "mail",
        title: "Email",
        description: "contact@full.dev",
        href: "mailto:contact@full.dev",
      },
      {
        icon: "phone",
        title: "Phone",
        description: "+31 6 83485163",
        href: "tel:+31683485163",
      },
      {
        icon: "map-pin",
        title: "Office",
        description: "Vismarkt 5a, 9712 CA Groningen",
        href: "https://maps.google.com/?q=Vismarkt%205a%2C%209712%20CA%20Groningen",
      },
      {
        icon: "clock",
        title: "Hours",
        description: "Weekdays, 9 am to 6 pm CET",
        href: "#",
      },
    ]}
    form={{
      title: "Send us a message",
      legend: "Contact form",
      nameLabel: "Name",
      namePlaceholder: "Jordan Lee",
      emailLabel: "Email",
      emailPlaceholder: "jordan@northwind.studio",
      messageLabel: "Message",
      messagePlaceholder:
        "We are refreshing our docs and need reusable sections for onboarding, changelogs, and feature launches.",
      actionLabel: "Send message",
    }}
  />
  <Steps />
  <Faqs4Block
    title="Frequently asked questions"
    faqs={[
      {
        id: "faq-hours",
        question: "How many hours do I need?",
        answer:
          "It depends on the result of your placement session, the daily time you commit to learning, and your motivation.",
      },
      {
        id: "faq-tailored",
        question: "Is it general or tailored and specific?",
        answer:
          "There is no clear-cut distinction. We tailor the course to get you ready for any exam as well as everyday and professional communication.",
      },
      {
        id: "faq-schedule",
        question: "What about the time and frequency of the classes?",
        answer:
          "That is between you and your instructor. You may have as many or as few hours per week as you want or need. We are flexible.",
      },
    ]}
  />
</Layout>
