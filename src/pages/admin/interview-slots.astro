---
import Layout from "@/layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import { listInterviewSlots } from "@/lib/server/signup";
import { Button } from "@/components/ui/button";
import { Icon } from "@/components/ui/icon";
import InterviewSlotForm from "@/components/admin/InterviewSlotForm.astro";
import { formatDateInTz } from "@/lib/time";

export const prerender = false;

const { user } = Astro.locals;
if (!user) {
  return Astro.redirect("/login");
}

const slots = await listInterviewSlots();

const fmt = (d: Date) =>
  formatDateInTz(d, {
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZoneName: "short",
  });

const result = Astro.getActionResult(actions.addInterviewSlot);
const addError =
  result?.error && result.error.code === "CONFLICT"
    ? result.error.message
    : null;
const genericAddError =
  result?.error && result.error.code !== "CONFLICT" ? result.error.message : null;
---

<Layout {user}>
  <div class="mx-auto w-full max-w-3xl py-6">
    <div class="mb-6">
      <h1 class="text-2xl font-semibold tracking-tight">Interview slots</h1>
      <p class="text-sm text-muted-foreground">
        Add or remove available interview times. Each booking removes a slot
        from this list.
      </p>
    </div>

    {(addError || genericAddError) && (
      <div
        role="alert"
        class="mb-4 rounded-md border border-destructive/30 bg-destructive/10 p-3 text-sm font-medium text-destructive"
      >
        {addError ?? genericAddError}
      </div>
    )}

    <div class="mb-8">
      <InterviewSlotForm />
    </div>

    {slots.length === 0 ? (
      <div class="rounded-lg border border-dashed px-4 py-12 text-center">
        <p class="text-sm text-muted-foreground">No slots yet.</p>
        <p class="mt-1 text-sm text-muted-foreground">
          Add one above and it'll appear here.
        </p>
      </div>
    ) : (
      <ul class="divide-y rounded-lg border">
        {
          slots.map((slot) => (
            <li class="flex items-center justify-between gap-3 px-4 py-3">
              <div class="font-medium">{fmt(slot.startsAt)}</div>
              <Button
                variant="destructive"
                size="sm"
                data-slot-id={slot.id}
                aria-label={`Remove ${fmt(slot.startsAt)}`}
              >
                <Icon name="trash" />
              </Button>
            </li>
          ))
        }
      </ul>
    )}
  </div>
</Layout>

<script>
  import { actions } from "astro:actions";

  document.querySelectorAll("button[data-slot-id]").forEach((button) => {
    button.addEventListener("click", async (event) => {
      event.preventDefault();
      const id = button.getAttribute("data-slot-id");
      if (!id) return;
      if (!confirm("Remove this interview slot?")) return;
      const { error } = await actions.removeInterviewSlot({ id });
      if (error) {
        alert(error.message);
        return;
      }
      button.closest("li")?.remove();
    });
  });
</script>
