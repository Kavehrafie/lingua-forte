---
import { Button } from "@/components/ui/button";
import {
  Field,
  FieldDescription,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@/components/ui/field";
import {
  Select,
  SelectContent,
  SelectGroup,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Form } from "@/components/ui/form";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";

import { actions, isInputError } from "astro:actions";
import Layout from "@/layouts/AdminLayout.astro";
import { getPageByID } from "@/lib/server/page";
import { Icon } from "@/components/ui/icon";
const { id } = Astro.params;
const { user } = Astro.locals;

export const prerender = false;

if (!id) {
  return Astro.redirect("/admin");
}

if (!user) {
  return Astro.redirect("/login");
}

const page = await getPageByID(id);

const result = Astro.getActionResult(actions.createPage);

if (result && !result.error) {
  // no redi
}

const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const pathConflict =
  result?.error &&
  !isInputError(result.error) &&
  result.error.code === "CONFLICT"
    ? result.error.message
    : null;
const pathInvalid = Boolean(fieldErrors.path) || Boolean(pathConflict);
---

<Layout {user}>
  <div class="mx-auto w-full max-w-4xl py-6">
    <h1 class="text-2xl font-semibold tracking-tight">
      {page?.title || "Edit Page"}
    </h1>
    <p class="mt-2 text-muted-foreground">
      Enter the title and path. You can add content blocks after creating it.
    </p>

    <Form class="mt-6 flex-row" method="post" action={actions.createPage}>
      <FieldGroup>
        <Field data-invalid={fieldErrors.title ? "true" : undefined}>
          <FieldLabel for="title">Title</FieldLabel>
          <Input
            id="title"
            name="title"
            placeholder="Getting Started"
            value={page?.title || ""}
            aria-invalid={fieldErrors.title ? "true" : undefined}
          />
          {
            fieldErrors.title && (
              <FieldError>{fieldErrors.title.join(", ")}</FieldError>
            )
          }
        </Field>

        <Field data-invalid={pathInvalid ? "true" : undefined}>
          <FieldLabel for="path">Path</FieldLabel>
          <Input
            id="path"
            name="path"
            value={page?.path || ""}
            placeholder="getting-started"
            aria-invalid={pathInvalid ? "true" : undefined}
          />
          <FieldDescription>
            Lowercase, hyphenated. Leading and trailing slashes are stripped
            automatically.
          </FieldDescription>
          {
            fieldErrors.path && (
              <FieldError>{fieldErrors.path.join(", ")}</FieldError>
            )
          }
          {pathConflict && <FieldError>{pathConflict}</FieldError>}
        </Field>

        <Field>
          <FieldLabel for="abstract">Abstract</FieldLabel>
          <Textarea
            id="abstract"
            value={page?.abstract || ""}
            name="abstract"
            placeholder="Short summary shown in listings"
          />
          <FieldDescription>Optional. Shown in page listings.</FieldDescription>
        </Field>

        <Field>
          <FieldLabel for="keywords">Keywords</FieldLabel>
          <Input
            id="keywords"
            name="keywords"
            value={page?.keywords || ""}
            placeholder="classes, tutoring, english"
          />
          <FieldDescription>Comma-separated.</FieldDescription>
        </Field>
      </FieldGroup>
      <FieldGroup>
        <Field>
          <FieldLabel>Add blocks</FieldLabel>
          <div class="flex gap-2">
            <Select defaultValue="" class="flex-1">
              <SelectTrigger>
                <SelectValue />
              </SelectTrigger>
              <SelectContent position="item-aligned">
                <SelectItem value="starter">Starter workspace</SelectItem>
                <SelectItem value="team">Team workspace</SelectItem>
                <SelectItem value="enterprise">Enterprise workspace</SelectItem>
              </SelectContent>
            </Select>
            <Button variant="outline" size="icon" aria-label="button">
              <Icon name="plus" />
            </Button>
          </div>
        </Field>
      </FieldGroup>
    </Form>
    <Button type="submit" class="w-fit self-end">Save</Button>
  </div>
</Layout>
