---
import Layout from "@/layouts/AdminLayout.astro";
import { actions, isInputError } from "astro:actions";
import { getPageByID } from "@/lib/server/page";
import PageForm from "@/components/admin/PageForm.astro";

export const prerender = false;

const { id } = Astro.params;
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/login");
}

if (!id) {
  return Astro.redirect("/admin");
}

const page = await getPageByID(id);
if (!page) {
  return Astro.redirect("/admin");
}

const result = Astro.getActionResult(actions.updatePage);

const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const nonInputError =
  result?.error && !isInputError(result.error) ? result.error : null;
const pathConflict =
  nonInputError && nonInputError.code === "CONFLICT"
    ? nonInputError.message
    : null;
const genericError =
  nonInputError && nonInputError.code !== "CONFLICT"
    ? nonInputError.message || "Something went wrong saving the page. Please try again."
    : null;
---

<Layout {user}>
  <div class="mx-auto w-full max-w-3xl py-6">
    <PageForm
      page={page}
      fieldErrors={fieldErrors}
      pathConflict={pathConflict}
      genericError={genericError}
    />
  </div>
</Layout>
