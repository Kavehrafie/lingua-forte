---
import Layout from "@/layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import { getPageByID } from "@/lib/server/page";
import BlocksList from "@/components/admin/BlocksList.astro";
import { Icon } from "@/components/ui/icon";

export const prerender = false;

const { id } = Astro.params;
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/login");
}

if (!id) {
  return Astro.redirect("/admin");
}

const page = await getPageByID(id);
if (!page) {
  return Astro.redirect("/admin");
}

// addBlock redirects to the new block's editor.
const addBlockResult = Astro.getActionResult(actions.addBlock);
if (addBlockResult && !addBlockResult.error && addBlockResult.data) {
  return Astro.redirect(
    `/admin/page/${addBlockResult.data.pageId}/blocks/${addBlockResult.data.id}`,
  );
}
---

<Layout {user}>
  <div class="mx-auto w-full max-w-3xl py-6">
    <a
      href={`/admin/page/${page.id}`}
      class="mb-4 inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"
    >
      <Icon name="arrow-left" />
      Back to page settings
    </a>

    <BlocksList page={page} />
  </div>
</Layout>

<script>
  import Sortable from "sortablejs";
  import { actions } from "astro:actions";

  const list = document.getElementById("blocks-list");
  if (list instanceof HTMLUListElement) {
    Sortable.create(list, {
      handle: "[data-drag-handle]",
      animation: 150,
      async onEnd() {
        const pageId = list.dataset.pageId;
        if (!pageId) return;

        const blockIds = Array.from(
          list.querySelectorAll<HTMLElement>("[data-block-id]"),
        ).map((el) => el.dataset.blockId);
        if (blockIds.some((bid) => !bid)) return;

        const { error } = await actions.reorderBlocks({
          pageId,
          blockIds: blockIds as string[],
        });

        if (error) {
          console.error("Reorder failed, reloading to resync:", error);
          window.location.reload();
        }
      },
    });
  }
</script>
